#!/usr/bin/expect -f
# Download a file from an old jailbreak sshd without the sftp subsystem:
# the remote `cat` is redirected to a local file by sh, so the bytes travel
# over a plain stdout pipe (no pty, no CR/LF mangling).
#
#   download_password.exp <password> <remote> <local>
set timeout 90
set password [lindex $argv 0]
set remote   [lindex $argv 1]
set local    [lindex $argv 2]

spawn sh -c "ssh -p 2222 \
    -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null \
    -o PreferredAuthentications=password \
    -o PubkeyAuthentication=no \
    -o KexAlgorithms=+diffie-hellman-group14-sha1,diffie-hellman-group1-sha1 \
    -o HostKeyAlgorithms=+ssh-rsa \
    -o Ciphers=+aes128-cbc,3des-cbc \
    root@127.0.0.1 'cat $remote' > '$local'"

expect {
    -re "(?i)password:" { send "$password\r"; exp_continue }
    -re "(?i)are you sure" { send "yes\r"; exp_continue }
    timeout {
        catch { close }
        catch { wait }
        exit 124
    }
    eof {}
}
catch wait result
exit [lindex $result 3]

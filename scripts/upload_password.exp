#!/usr/bin/expect -f
# Upload a file to an old jailbreak sshd WITHOUT the sftp subsystem:
# the payload is piped into `ssh ... cat > remote`, which works on every
# OpenSSH/dropbear build (scp -O / sftp often stall on iOS 6/7).
#
#   upload_password.exp <password> <local> <remote>
set timeout 90
set password [lindex $argv 0]
set local    [lindex $argv 1]
set remote   [lindex $argv 2]

spawn sh -c "cat '$local' | ssh -p 2222 \
    -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null \
    -o PreferredAuthentications=password \
    -o PubkeyAuthentication=no \
    -o KexAlgorithms=+diffie-hellman-group14-sha1,diffie-hellman-group1-sha1 \
    -o HostKeyAlgorithms=+ssh-rsa \
    -o Ciphers=+aes128-cbc,3des-cbc \
    root@127.0.0.1 'cat > $remote'"

expect {
    -re "(?i)password:" { send "$password\r"; exp_continue }
    -re "(?i)are you sure" { send "yes\r"; exp_continue }
    timeout {
        catch { close }
        catch { wait }
        exit 124
    }
    eof {}
}
catch wait result
exit [lindex $result 3]

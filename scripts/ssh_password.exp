#!/usr/bin/expect -f
# Password-auth ssh for old jailbreak sshd (legacy algorithms, no sshpass).
#   ssh_password.exp <password> <remote command>
# Old iPhone hardware answers the SSH banner slowly (~10 s on an iPhone 4 with
# SpringBoard busy), so never pass -o ConnectTimeout: it also caps the banner
# exchange and kills the session with "timed out during banner exchange".
set timeout 60
set password [lindex $argv 0]
set command  [lindex $argv 1]

spawn ssh -p 2222 \
    -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null \
    -o PreferredAuthentications=password \
    -o PubkeyAuthentication=no \
    -o KexAlgorithms=+diffie-hellman-group14-sha1,diffie-hellman-group1-sha1 \
    -o HostKeyAlgorithms=+ssh-rsa \
    -o Ciphers=+aes128-cbc,3des-cbc \
    root@127.0.0.1 $command

expect {
    -re "(?i)password:" { send "$password\r"; exp_continue }
    -re "(?i)are you sure" { send "yes\r"; exp_continue }
    timeout {
        # Never hang the caller: drop the channel and report a timeout.
        catch { close }
        catch { wait }
        exit 124
    }
    eof {}
}
catch wait result
exit [lindex $result 3]
